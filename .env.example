# BBCare environment template. Copy to .env (never commit real values).
# Values below are placeholders.

# Runtime
# NODE_ENV is set by Next.js and tooling; do not set it here.
BBCARE_ENV=development            # development | preview | staging | production
BBCARE_BASE_URL=http://localhost:3000

# Database (use a database name ending in _dev, _test, _ci or _preview for disposable data)
DATABASE_URL=postgres://bbcare:CHANGE_ME@localhost:5432/bbcare_dev

# Secrets: generate with `openssl rand -base64 32`
BBCARE_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
BBCARE_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# Optional: fixed password for synthetic seed accounts (otherwise generated)
BBCARE_SEED_PASSWORD=

# AI provider: mock | flask | none
BBCARE_AI_PROVIDER=mock
# Existing Flask AI service (private network only; never a public address)
# Private address of the local AI gateway (infra/flask-ai-service, bound to 127.0.0.1:5001 by Antigravity) as
# reachable from the BBCare process. Public hostnames are refused. When BBCare runs on the same host without
# Docker use http://127.0.0.1:5001; when it runs in Docker, 127.0.0.1 is the container itself, so use the
# Nginx private proxy (infra/nginx/ai-proxy.conf.template) or http://host.docker.internal:<port> with the
# gateway bound to the Docker bridge address. Decision recorded in docs/server-handoff/BBCare-AI-INTEGRATION.md.
BBCARE_FLASK_AI_URL=http://127.0.0.1:5001
BBCARE_FLASK_AI_TOKEN=REPLACE_ON_SERVER_ONLY   # bearer token issued by the gateway; set on the two hosts only, never in Git or chat
BBCARE_FLASK_AI_CHAT_PATH=/api/chat
BBCARE_FLASK_AI_EMBED_PATH=/api/embed
BBCARE_FLASK_AI_HEALTH_PATH=/health
BBCARE_FLASK_AI_MODEL=qwen2.5:7b          # must be in the gateway ALLOWED_MODELS list
BBCARE_AI_TIMEOUT_MS=30000
BBCARE_AI_MAX_CONCURRENCY=2

# File storage for uploads (private directory, not web-served)
BBCARE_STORAGE_DIR=./storage

# Offline IP geolocation file: DB-IP Lite CSV or the compact file from infra/scripts/geoip-convert.mjs (docs/analytics/geographic-analytics.md)
BBCARE_GEOIP_CSV=

# Optional: staff may type only the local part of their work address at /admin/login (for example "aina" for aina@example.com)
BBCARE_STAFF_LOGIN_DOMAIN=

# Preview access gate (optional HTTP basic auth for preview/staging; set on the host only)
BBCARE_PREVIEW_USER=
BBCARE_PREVIEW_PASSWORD=

# Commerce
BBCARE_LISTING_VERIFICATION_DAYS=14
BBCARE_SUPPORT_CONTACT_WHATSAPP=
BBCARE_SUPPORT_CONTACT_EMAIL=
NEXT_TELEMETRY_DISABLED=1
