# Optional authenticating proxy in front of the existing Flask AI service.
# Install on the AI server only with owner approval. Listens on the PRIVATE interface only.
# Replace placeholders: PRIVATE_IP, PROXY_PORT, FLASK_PORT. Store the token hash in a separate
# file readable by nginx only: /etc/nginx/bbcare-ai-token.conf containing
#   set $bbcare_expected "Bearer <long-random-token>";
server {
    listen PRIVATE_IP:PROXY_PORT;
    server_name _;
    client_max_body_size 256k;
    include /etc/nginx/bbcare-ai-token.conf;

    location / {
        if ($http_authorization != $bbcare_expected) { return 401; }
        proxy_pass http://127.0.0.1:FLASK_PORT;
        proxy_set_header Authorization "";
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
    }
}
