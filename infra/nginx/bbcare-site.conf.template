# BBCare public site behind Nginx (TLS terminated here or by Cloudflare Tunnel).
# Replace: SERVER_NAME, WEB_PORT (the 127.0.0.1 port from the env file), certificate paths.
# IMPORTANT: X-Forwarded-For is OVERWRITTEN with the real client address, never appended,
# because BBCare uses it for rate limiting. The app port must only listen on 127.0.0.1.
limit_req_zone $binary_remote_addr zone=bbcare_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=bbcare_chat:10m rate=1r/s;

server {
    listen 80;
    server_name SERVER_NAME;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name SERVER_NAME;
    ssl_certificate     /etc/letsencrypt/live/SERVER_NAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/SERVER_NAME/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 16m;          # admin uploads; public JSON endpoints enforce their own limits
    proxy_read_timeout 75s;

    location /api/public/support/sessions/ {
        limit_req zone=bbcare_chat burst=10 nodelay;
        include /etc/nginx/snippets/bbcare-proxy.conf;
    }
    location /api/ {
        limit_req zone=bbcare_api burst=40 nodelay;
        include /etc/nginx/snippets/bbcare-proxy.conf;
    }
    location / {
        include /etc/nginx/snippets/bbcare-proxy.conf;
    }
}

