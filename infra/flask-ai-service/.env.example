# BBCare Local AI Gateway Environment Configuration
# Copy to .env or load into service environment. Never commit .env with real secrets.

# Bind Address (strict loopback, never expose publicly)
AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=5001

# Ollama Endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Security: Bearer Token for service communication (generate with: openssl rand -hex 32)
AI_GATEWAY_BEARER_TOKEN=generate-a-strong-token-with-openssl-rand-hex-32

# Models
DEFAULT_MODEL=qwen2.5:7b
FALLBACK_MODEL=qwen2.5:3b
ALLOWED_MODELS=qwen2.5:7b,qwen2.5:3b

# Resource Protection
MAX_CONCURRENCY=2
QUEUE_TIMEOUT_SECONDS=5.0
REQUEST_TIMEOUT_SECONDS=90.0
LOG_LEVEL=INFO
